# 로컬 개발은 값이 없어도 docker-compose 기본값으로 동작합니다.
# 배포(Railway/Render 등) 시 아래 값을 환경 변수로 설정하세요.

# Supabase > Project Settings > Database > Connection string (Session pooler, 포트 5432)
DB_URL=jdbc:postgresql://<host>.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=

# Upstash Redis (TLS는 rediss://)
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# 32자 이상 랜덤 문자열 (예: openssl rand -base64 48)
JWT_SECRET=

# Vercel 배포 주소 (여러 개면 쉼표로 구분)
CORS_ALLOWED_ORIGINS=https://<your-app>.vercel.app

# (선택) 카카오 로컬 API 키 - 지역 검색 자동완성 품질 향상. 없으면 내장 지역 목록 사용
# https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
KAKAO_REST_API_KEY=

# 메일 (아이디·비밀번호 찾기). 로컬은 비워 두면 Mailpit(http://localhost:8025) 사용
# Gmail 예: MAIL_HOST=smtp.gmail.com MAIL_PORT=587 MAIL_SMTP_AUTH=true MAIL_STARTTLS=true
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=
MAIL_STARTTLS=
MAIL_FROM=FitMate <no-reply@your-domain.com>
