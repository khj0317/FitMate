# Railway(백엔드) 환경 변수 예시. 실제 값은 Railway 대시보드의 Variables에 넣고, 이 파일에는 절대 넣지 마세요.
# 자세한 과정은 DEPLOY.md 참고

# --- Supabase Postgres (Connect → Session pooler, 포트 5432) ---
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<database-password>
DB_POOL_SIZE=5

# --- Upstash Redis (TLS라서 rediss://) ---
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# --- 보안 ---
# 32자 이상 랜덤 문자열 (예: openssl rand -base64 48)
JWT_SECRET=<random-64-chars>
# Vercel 웹 주소 (여러 개면 쉼표로 구분, * 패턴 가능: https://fitmate-*-내계정.vercel.app)
CORS_ALLOWED_ORIGINS=https://<your-app>.vercel.app

# --- 사진 저장소: Supabase Storage (S3 호환) ---
STORAGE_TYPE=s3
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_BUCKET=fitmate
S3_ACCESS_KEY=<storage-s3-access-key-id>
S3_SECRET_KEY=<storage-s3-secret-access-key>
S3_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/fitmate
S3_PATH_STYLE=true

# --- 체험 계정 (포트폴리오 방문자용 demo01 ~ demo30) ---
DEMO_DATA_ENABLED=true

# --- 선택: 메일 (아이디·비밀번호 찾기). 없으면 메일 발송만 실패하고 나머지는 동작 ---
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=<gmail-address>
# MAIL_PASSWORD=<gmail-app-password>
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_FROM=FitMate <gmail-address>

# --- 선택: 카카오 지역 검색 (없으면 내장 전국 지역 목록 사용) ---
# KAKAO_REST_API_KEY=<kakao-rest-api-key>
