# 배포(Vercel) 시 백엔드 주소 (실시간 채팅 WebSocket 연결에 사용).
# REST(/api) 요청은 vercel.json의 rewrite가 백엔드로 전달하므로 같은 주소로 보냅니다. 로컬 개발에서는 비워 두면 Vite 프록시를 사용합니다.
VITE_API_URL=https://<your-backend>.onrender.com

# 카카오맵 JavaScript 키 (모임 지도). 브라우저에 공개되는 키이고, 카카오 개발자 콘솔의
# [앱] > [플랫폼 키] > [JavaScript 키] > [JavaScript SDK 도메인]에 등록한 주소에서만 동작합니다.
VITE_KAKAO_MAP_KEY=
